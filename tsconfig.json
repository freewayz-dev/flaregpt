{
  "compilerOptions": {
    /* Project layout. No `baseUrl` — deprecated as of TS 6.0 (removed in
       7.0) now that `paths` resolves relative to this file's own
       directory under "bundler" moduleResolution without needing one. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Vite/SWC does the real transpilation and bundling — tsc here is
       type-checking only and never emits. isolatedModules matches what
       SWC actually requires (every file independently transpilable, no
       cross-file type-only tricks that need a full program to resolve). */
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* prerender.ts runs via plain `node prerender.ts` (Node's own native
       TS type-stripping, not Vite) and imports src/test/polyfills.ts by a
       real relative path with its extension — Node's own ESM resolution
       requires that explicit `.ts` for a direct relative import, unlike
       "bundler" moduleResolution's extension-optional style everywhere
       else in this project. Only legal alongside `noEmit` (true above),
       which this project already has for unrelated reasons. */
    "allowImportingTsExtensions": true,

    /* Matches vite.config.ts's own declared build target
       (`build.target: "es2020"`) for syntax-availability checking. `lib`
       is kept a little ahead of that on purpose — it governs which
       runtime APIs TS assumes exist, which is a separate question from
       what syntax Vite's own output targets, and the Node 24 / evergreen
       browsers this app actually runs in during dev and test genuinely
       have the newer APIs. */
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    /* Vite is the bundler, not tsc or plain Node — "bundler" resolution
       (TS 5+) models that directly (package.json exports/imports
       conditions, no forced extensions on relative imports), matching how
       this app's imports actually resolve instead of the stricter classic
       Node rules that don't. */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Automatic JSX runtime — matches this codebase's existing convention
       exactly (confirmed zero `import React from "react"` anywhere in
       src/ during the React 19 audit). */
    "jsx": "react-jsx",

    /* Ambient globals for the two runtime contexts real files in this
       repo run in: browser app code (`dom`, via `lib` above, plus Vite's
       own import.meta.env/query-import types) and the genuinely
       Node-context files (vite.config.ts, playwright.config.ts,
       prerender.ts, translate-locales.ts, e2e/static-server.ts,
       i18next-parser.config.ts, tailwind.config.ts, postcss.config.ts).
       One shared config rather than a project-references split
       (tsconfig.app.json/tsconfig.node.json, the pattern Vite's own
       create-vite template uses) — this repo has only a handful of
       Node-context files today, not enough to justify the extra moving
       parts a split introduces. Revisit if that stops being true. */
    "types": ["vite/client", "node"],

    /* Stage 2 of the staged-strictness plan (Stage 1 — noImplicitAny only —
       shipped with the file-by-file migration itself). Every nullable
       value across the whole app now has to be handled correctly, not just
       every parameter/variable typed. Full `strict: true` was tried and
       deliberately NOT kept: it also turns on strictFunctionTypes, which
       breaks the `AnyProtocol` type-erasure boundary in
       DefiProtocols/components/ProtocolExplorer.tsx (documented there) —
       that boundary is a real, load-bearing architectural decision from
       Phase 4, not something to redesign as a side effect of a config
       change. Revisit full `strict: true` as its own deliberate, reviewed
       migration if that boundary is ever redesigned; don't flip it ahead
       of that. */
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,

    /* Housekeeping every modern TS project wants regardless of strictness
       stage. */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  /* Every file the app itself runs, and every tooling/build script that
     invokes TypeScript directly, is .ts/.tsx now — allowJs/checkJs (Phase
     0's incremental-adoption scaffolding) are long gone. prerender.ts and
     translate-locales.ts run via plain `node prerender.ts` — safe since
     this project's `engines.node` (">=24") already guarantees the Node
     version that runs erasable TypeScript syntax natively, no loader
     needed; confirmed empirically, not assumed. e2e/static-server.ts is
     the same story, invoked by Playwright's own `webServer.command`.
     eslint.config.js is the one tooling config that's staying .js — see
     its own top-of-file comment for why. */
  "include": [
    "src",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "prerender.ts",
    "translate-locales.ts",
    "i18next-parser.config.ts",
    "tailwind.config.ts",
    "postcss.config.ts"
  ],
  /* src/sw.ts (and src/sw.emergency.ts — see docs/pwa/emergency-kill-
     switch.md) run in the ServiceWorkerGlobalScope, not a browser window —
     they need the `webworker` lib, which declares several of the same
     globals (`self` included) incompatibly with this config's own `dom`
     lib. Excluded from this program and checked separately, against their
     own `lib`, by tsconfig.sw.json — see package.json's `typecheck`
     script, which runs both, so this isn't a silent type-checking gap. */
  "exclude": ["node_modules", "dist", "src/sw.ts", "src/sw.emergency.ts"]
}
